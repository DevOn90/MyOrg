{
  "name": "toggleSwitch",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "shared/components/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "shared/components/ng-package.json",
        "stylesPreprocessorOptions": {
          "includePaths": ["shared/styles/src/lib"]
        }
      },
      "configurations": {
        "production": {
          "tsConfig": "shared/components/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "shared/components/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
